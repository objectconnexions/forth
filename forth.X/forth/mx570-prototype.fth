noecho

\ for MX570 prototype PCB

DECIMAL

\ LEDs
PORTE 1 2CONSTANT PWR_LED			\ GREEN -- Power
PORTB 7 2CONSTANT ACT_LED	    	\ GREEN - Status
PORTB 8 2CONSTANT ERROR_LED			\ RED -- Error
PORTE 0 2CONSTANT COMMS_LED			\ GREEN -- Comms
PORTB 9 2CONSTANT MNT_LED			\ GREEN - Monitor

\ Digital IO
PORTB 0 2CONSTANT PB1			\ PUSH BUTTON -- test/wake
PORTE 3 2CONSTANT DIO1			\ RE3 -- pin 5 on M1
PORTB 3 2CONSTANT DIO2			\ RB3/CN5/AN3 -- pin 6 on M1
PORTB 2 2CONSTANT DIO3			\ RB2/CN4/AN2 -- pin 10 on M1
PORTD 8 2CONSTANT DIO4			\ RD8/INT1/RTCC -- pin 12 on M1

PORTD 4 2CONSTANT DIO5			\ RD4/CN13 -- pin 5 on M21
PORTD 1 2CONSTANT DIO6			\ RD1/SCK3/U4TX -- pin 6 on M2
PORTB 6 2CONSTANT DIO7			\ RB6/AN6 -- pin 10 on M2
PORTD 0 2CONSTANT DIO8			\ RD0/INT0 -- pin 12 on M2

PORTD 7 2CONSTANT DIO9			\ RD7/CN16 -- pin 5 on M1
PORTB 4 2CONSTANT DIO10			\ RB4/CN6/AN4 -- pin 6 on M1
PORTE 4 2CONSTANT DIO11			\ RE4 -- pin 10 on M1
PORTD 11 2CONSTANT DIO12		\ RD11/INT4 -- pin 12 on M1


\ UART 1 -- RS485
\ p50 RX
\ p51 TX
\ TXEN - RB14, p29
\ RXEN - RG9, p8

\ SPI 2 -- flash and EEPROM
\ SCK2 - RG6, p4
\ SDI2 - RG7, p5
\ SDO2 - RG8, p6

\ SPI ID -- 25AA02UID
\ CS RE5, p1

\ SPI EEPROM -- 25LC256
\ RE7, p3

\ SPI Flash -- N25Q032
\ RE6, p2

\ CAN
\ C1TX - RF1
\ C1RX - RF0
\ CEN -  RE2, p62

\ I2C - no pull ups!
\ SCL1 - RD10, p44
\ SDA2 - RD9, p43

\ ADC
PORTA 10 2CONSTANT PWR_LEVEL			\ external voltage

.( Ports set up for PIC32MX570 based PCB) CR
echo
