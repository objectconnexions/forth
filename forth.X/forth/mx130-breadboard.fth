noecho

\ for MX130 breadboard

DECIMAL

\ LEDs
PORTB 14 2CONSTANT PWR_LED			\ GREEN
PORTB 15 2CONSTANT ACT_LED			\ RED

\ LCD
PORTB 12 2CONSTANT LCD_RS			\ LCD RS
PORTB 3 2CONSTANT LCD_EN			\ LCD EN
PORTB 6 2CONSTANT LCD_D0			\ LCD DB0
PORTB 7 2CONSTANT LCD_D1			\ LCD DB1
PORTB 8 2CONSTANT LCD_D2			\ LCD DB2
PORTB 9 2CONSTANT LCD_D3			\ LCD DB3

\ Digital IO
PORTB 11 2CONSTANT PB1			\ PUSH BUTTON
PORTB 2 2CONSTANT RB2               \ pin 9
PORTB 3 2CONSTANT RB3               \ pin 10
PORTB 13 2CONSTANT RB13               \ pin 24

\ ADC
PORTA 0 2CONSTANT ADC_TEMP			\ pin 2 - AN0, Temperature
0 CONSTANT TEMP				        \ pin 2 - AN
PORTB 2 2CONSTANT ADC_VR    		\ pin 6 - AN4, VR
4 CONSTANT VOLTAGE                  \ pin 6 - AN4
PORTB 13 2CONSTANT ADC_AN11          \ pin 24 - AN11
11 CONSTANT AN11                    \ pin 24 - AN11

.( added breadboard ports)
echo
