noecho
.( Dictionary reset) CR
\ _reset

HEX

\ System Registers
0bf80f000 CONSTANT OSCCON
0bf80f200 CONSTANT CFGCON
0bf80f230 CONSTANT SYSKEY

$0D CONSTANT CFG_PPS

\ Interupt Registers
0bf881000 CONSTANT INTCON
0bf881010 CONSTANT INTSTAT
0bf881020 CONSTANT IPTMR
0bf881030 CONSTANT IFS0
0bf881040 CONSTANT IFS1
0bf881060 CONSTANT IEC0
0bf881070 CONSTANT IEC1
0bf881090 CONSTANT IPC0

\ Timer Registers
0bf800a00 CONSTANT T3CON
0bf800a10 CONSTANT TMR3
0bf800a20 CONSTANT PR3

0bf886000 CONSTANT PORTA
0bf886100 CONSTANT PORTB
0bf886200 CONSTANT PORTC
0bf886300 CONSTANT PORTD
0bf886400 CONSTANT PORTE
0bf886500 CONSTANT PORTF

\ Port register offsets
$00 CONSTANT ANSEL
$10 CONSTANT TRIS
$20 CONSTANT PORT
$30 CONSTANT LAT
$40 CONSTANT ODC
$50 CONSTANT CNPU
$60 CONSTANT CNPD
$70 CONSTANT CNCON
$80 CONSTANT CNEN
$90 CONSTANT CNSTAT


04 CONSTANT REG_CLR
08 CONSTANT REG_SET
0c CONSTANT REG_INV

\ Convert virtual address to a physical one
: TO_VIRTUAL_ADDR ( addr - addr )	0x80000000 OR ;
: TO_PHYSICAL_ADDR ( addr - addr )	0x1fffffff AND ;

\ Calculate the address of the register for the specified offset.
\ Each register is 0x10 bytes apart
\   Offset
\   Base register address
: OFFSET_REGISTER ( n addr - addr )
	SWAP $10 * +          	     	\ reg addr for the offset
;

\ DEPRECATED
: REG_BY_OFFSET ( port register -- register )
	PORTA -				\ offset to register
	+ 					\ adjust port address
;

\ Calculate the register address for a port and offset
\   port - PORTA~PORTF
\   offset - register type: ANSEL, TRIS, PORT, LAT etc
: REGISTER ( a-addr u -- a-addr )
\	PORTA -				\ offset to register
	+ 					\ adjust port address
;

: MASK_BIT ( pos - mask )
	1 swap				\ address 1 bit --
	lshift				\ determine mask
;

\ Create a bit mask of n bits, where each bit is set to 1, at specified position
\   no of bits wide
\   position that mask starts
\ : MASK ( size pos - mask ) -> MASK_PATTERN
: MASK_PATTERN ( size pos - mask )
	swap
	1 swap lshift 1 -	\ basic mask
	swap lshift			\ move into position
;

: REG_BIT@ ( address bit -- val )
	SWAP @					\ read register
	swap rshift			\ align bit
	01 and				\ exclude rest
;

\ : REG_BIT_READ_OFFSET ( bit base-address offset -- val )
\ 	or			 		\ calculate address
\ 	REG_BIT@
\ ;


\ display register bit
: REG_BIT? ( address n -- )
	REG_BIT@ .
;

\ set bit at position in register
: REG_BIT_SET ( address bit -- ) 
	MASK_BIT
	SWAP REG_SET or
	!
;

\ clear bit at position in register
: REG_BIT_CLEAR ( address bit -- ) 
	MASK_BIT
	SWAP REG_CLR or
	!	
;

\ invert bit at position in register
: REG_BIT_INVERT ( address bit -- ) 
	MASK_BIT
	SWAP REG_INV or
	!
;

\ write bit at position in register
: REG_BIT! ( flag address bit -- )
\    ROT IF REG_BIT_SET ELSE REG_BIT_CLEAR THEN
    ROT IF REG_BIT_SET ELSE REG_BIT_CLEAR THEN
;

\ read bits at position in register
: REG_BITS@ ( address pos len -- value ) 
	ROT @ ROT RSHIFT					\ read register and align bits according to positon
	SWAP								\ ( val len )
	0 MASK_PATTERN AND			    	\ create mask and dipose of other bits
;

\ read bits at position in register
: REG_BITS? ( address pos len -- ) 
	REG_BITS@ .
;

\ write bits at position in register
: REG_BITS! ( value address pos len -- ) 
	ROT SWAP 2SWAP						\ ( addr len val pos)
	SWAP ROT					    \ ( - pos val len )
	0 MASK_PATTERN					\ ( - - val mask ) generate a mask for the bits within the register
	
	DUP ROT 					    \ ( - pos mask mask val )
	AND								\ ( - pos mask masked-value )
	LROT						    \ ( - masked-value pos mask )
	OVER LSHIFT						\ ( - - pos clear-out ) calculate the clear mask register change value 

	LROT    						\ ( - pos clear-out masked-value pos )
	LSHIFT							\ ( - pos clear-out value-out) calculate the register clear value 
	
	
	ROT SWAP OVER					\ ( clear-out addr val-out addr )
	2SWAP
\	.S CR
	REG_CLR OR !					\ clear register section bits
	REG_SET OR !					\ write register section
;

\ PORTB ANSEL REGISTER 5 REG_BIT_CLEAR
\ PORTB TRIS REGISTER 5 REG_BIT_SET
\     

\ ( bit port -- )
\ port, line   
: DIGITAL_IN ( a-addr n -- )   
	\ swap 2dup				\ copy params
	
	over ANSEL REGISTER over REG_BIT_CLEAR
    swap TRIS REGISTER swap REG_BIT_SET

	
\	ANSELA REG_BY_OFFSET \ offset to reister
\	REG_BIT_CLEAR		\ clear analogue flag
\	TRISA REG_BY_OFFSET	\ offset to reister
\	REG_BIT_SET   		\ set TRIS register to input
;

\ port, line
: PULL_UP ( a-addr n -- )   
    over CNPD REGISTER over REG_BIT_CLEAR     \ PULL DOWN register cleared
    swap CNPU REGISTER swap REG_BIT_SET       \ PULL UP register set


\    2dup
\	CNPDA REG_BY_OFFSET	\ offset to reister
\	REG_BIT_CLEAR  		\ PULL DOWN register cleared
\	CNPUA REG_BY_OFFSET	\ offset to reister
\	REG_BIT_SET   		\ PULL UP register set
;

\ port, line
: PULL_DOWN ( a-addr n -- )   
    over CNPD REGISTER over REG_BIT_SET       \ PULL DOWN register set
    swap CNPU REGISTER swap REG_BIT_CLEAR     \ PULL UP register cleared

\	2dup
\	CNPDA REG_BY_OFFSET	\ offset to reister
\	REG_BIT_SET   		\ PULL DOWN register set
\	CNPUA REG_BY_OFFSET	\ offset to reister
\	REG_BIT_CLEAR  		\ PULL UP register cleared
;

\ port, line
: DIGITAL_OUT ( a-addr n -- )   
	over ANSEL REGISTER over REG_BIT_CLEAR      \ clear analogue flag
    over TRIS REGISTER over REG_BIT_CLEAR       \ set to input
    swap PORT REGISTER swap REG_BIT_CLEAR       \ set output to off


\	2dup				\ copy params
\	ANSELA REG_BY_OFFSET \ offset to register
\	REG_BIT_CLEAR		\ clear analogue flag
\	2dup
\	TRISA REG_BY_OFFSET	\ offset to register
\	REG_BIT_CLEAR  		\ set TRIS register to input
\	REG_BIT_CLEAR  		\ set output off
;

\ turn bit off on the port
\   port bit
\   port address
: DIGITAL_ON ( u-addr n -- ) 
    swap PORT REGISTER SWAP
    REG_BIT_SET
;

\ turn bit off on the port
\   port bit
\   port address
: DIGITAL_OFF ( u-addr n -- ) 
    swap PORT REGISTER SWAP
    REG_BIT_CLEAR
;

\ turn bit off on the port
\   port bit
\   port address
: DIGITAL_INVERT ( u-addr n -- ) 
    swap PORT REGISTER SWAP
    REG_BIT_INVERT
;


\ turn bit off on the port
\   port bit
\   port address
\   flag
: DIGITAL! ( f u-addr n -- ) 
    swap PORT REGISTER SWAP
    REG_BIT!
;

\ turn bit off on the port
\   port bit
\   port address
\   flag
: DIGITAL@ ( u-addr n -- f ) 
    swap PORT REGISTER SWAP
    REG_BIT@
;

\ turn bit off on the port
\   port bit
\   port address
\   flag
: DIGITAL? ( u-addr n -- f ) 
    swap PORT REGISTER SWAP
    REG_BIT?
;

: SYS_UNLOCK ( -- )
	0x0aa996655 SYSKEY !		\ write unlock sequence
	0x0556699aa SYSKEY !
;

: SYS_LOCK ( -- )
	0x33333333 SYSKEY !			\ write lock sequence
;

: SYS_IOLOCK ( state -- ) 

;

: PPS_UNLOCK ( - )
	SYS_UNLOCK
	CFGCON CFG_PPS REG_BIT_CLEAR	
;

: PPS_LOCK ( - )
	CFGCON CFG_PPS REG_BIT_SET	
	SYS_LOCK
;


\ time on, time off, port, line
: LED_FLASH ( u u a-addr u - )
	\ on and off duration are one double (timing);
	\ addr and port are another (location)

    2DUP DIGITAL_OUT
    swap PORT REGISTER SWAP
	begin
        2DUP REG_BIT_SET

		2SWAP	\ bring timings to top
		2DUP	
        ms		\ delay for first period (on) - in top of double
		drop	\ drop the other half
		
		2SWAP 	\ return location to top
        2DUP REG_BIT_CLEAR

		2SWAP	\ bring timings to top
		2DUP	
		drop	\ drop the first half ro expose the off time
        ms		\ delay for second period

		2SWAP	\ bring location back to top
	again
;

: VAR_LED_FLASH ( variable addr port - )
	\ on and off duration are one double (timing);
	\ addr and port are another (location)

    2DUP DIGITAL_OUT
    swap PORT REGISTER SWAP
    begin
        2DUP REG_BIT_SET	\ turn on

		ROT DUP 2@		\ read variable to get both times (addr port var t1 t2)
        ms				\ delay for first period (on) - in top of double

		2OVER 			\ copy location to top
        REG_BIT_CLEAR	\ turn off

        ms				\ delay for second period

		ROT ROT			\ return the variable to bottom
	again
 ;
DECIMAL





\ 1's complement
: invert ( n - n ) NEGATE 1 - ;


\ source
\ value
\ pos
\ length
: set_bits ( n n n n - n )
    OVER MASK_PATTERN INVERT    \ mask
    LROT LSHIFT                 \ new value
    LROT AND                      \ mask the source VALUE
    OR                           \ combine
;

\ source
\ pos
\ length
: get_bits ( n n n - n )
    OVER MASK_PATTERN            \ mask
    ROT AND                      \ mask the source VALUE
    SWAP RSHIFT                 \ value
;

: +! ( addr - )
    DUP @ 1+ SWAP !
;

: .HEXS ( )
    HEX .S DECIMAL
;



.( Added basic common words) CR
echo
